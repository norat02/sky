# ===== Public client variables (safe to expose in Web/App bundle) =====
# Production URL dùng cho canonical, OAuth Web redirect và sitemap.
VITE_PUBLIC_SITE_URL=https://your-production-domain.vercel.app/
# Web có thể để trống để dùng /api; Android cần URL Vercel production.
VITE_API_BASE_URL=https://your-production-domain.vercel.app
# Supabase project URL và publishable/anon key; không phải service role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# OAuth callback scheme đã đăng ký trong Supabase Redirect URLs.
VITE_NATIVE_OAUTH_REDIRECT_SCHEME=com.norat02.skybird
# Optional: AdSense publisher ID là public, chỉ cần nếu đã cấu hình CMP production.
ADSENSE_PUBLISHER_ID=ca-pub-xxxxxxxxxxxxxxxx

# ===== Server-only variables (never expose to Web/App/APK) =====
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require
# Có thể dùng NEON_DATABASE_URL thay cho DATABASE_URL.
NEON_DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SCORE_SIGNING_SECRET=generate-a-random-secret-at-least-32-chars
ADMIN_EMAILS=admin@example.com
ADMIN_USER_IDS=
# Optional server OAuth/API configuration.
SUPABASE_REDIRECT_URL=https://your-production-domain.vercel.app/
