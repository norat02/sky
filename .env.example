# Public URL dùng cho canonical, robots.txt và sitemap.xml trên Vercel
PUBLIC_SITE_URL=https://your-production-domain.vercel.app/

# Neon PostgreSQL — chỉ dùng trong Vercel Serverless Functions, KHÔNG đưa vào config.js
# Lấy connection string trong Neon Console → Connect → Pooled connection
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require
# Có thể dùng NEON_DATABASE_URL thay cho DATABASE_URL
NEON_DATABASE_URL=

# Supabase Auth — vẫn dùng để xác minh Bearer token; database đã chuyển sang Neon
# Lấy tại Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SCORE_SIGNING_SECRET=generate-a-long-random-secret-at-least-32-chars

# Tùy chọn: domain production Vercel dùng cho OAuth redirect
# Nếu để trống, ứng dụng tự dùng domain hiện tại (production/preview)
SUPABASE_REDIRECT_URL=https://your-production-domain.vercel.app/

# Quyền admin — chỉ dùng trong Vercel Serverless Functions, không đưa vào config.js
# Nhiều giá trị phân tách bằng dấu phẩy; có thể dùng email hoặc UUID của user Supabase
ADMIN_EMAILS=admin@example.com
ADMIN_USER_IDS=
